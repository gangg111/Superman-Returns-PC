<Window x:Class="SupermanReturnsLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Superman Returns PC" Width="1040" Height="780" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Bg}">
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="SUPERMAN" FontSize="29" FontWeight="ExtraBold"/>
     <TextBlock Text="RETURNS" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <TextBlock x:Name="TaglineText" FontSize="13" Margin="1,4,0,28" Foreground="{StaticResource Muted}"/>
     <TextBlock x:Name="ReadyText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20"/>
     <Button x:Name="PlayButton" Height="52" FontSize="18" Click="Play_Click"/>
     <Button x:Name="SaveButton" Margin="0,12,0,0" Background="#30394A" Click="Save_Click"/>
     <Button x:Name="DefaultsButton" Margin="0,10,0,0" Background="Transparent" FontSize="11" Padding="4,10" Click="Defaults_Click"/>
     <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="LanguageLabel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
     <UniformGrid Columns="2" Margin="0,8,0,0">
      <Button x:Name="EnglishButton" Content="EN" Margin="0,0,4,0" Click="English_Click" AutomationProperties.Name="English"/>
      <Button x:Name="PolishButton" Content="PL" Margin="4,0,0,0" Click="Polish_Click" AutomationProperties.Name="Polski"/>
     </UniformGrid>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
   <StackPanel>
    <TextBlock x:Name="HeadingText" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,0">
      <TextBlock x:Name="RendererLabel"/><ComboBox x:Name="RendererBox"/>
      <TextBlock x:Name="ApiLabel"/><ComboBox x:Name="ApiBox"/>
      <TextBlock x:Name="ResolutionLabel"/><ComboBox x:Name="ResolutionBox"/>
      <TextBlock x:Name="DisplayModeLabel"/><ComboBox x:Name="DisplayModeBox"/>
      <TextBlock x:Name="GpuLabel"/><ComboBox x:Name="GpuBox"/>
      <TextBlock x:Name="InputLabel"/><ComboBox x:Name="InputBox"/>
     </StackPanel>
     <StackPanel Margin="12,0,0,0">
      <TextBlock x:Name="RenderScaleLabel"/><ComboBox x:Name="RenderScaleBox"/>
      <TextBlock x:Name="AaLabel"/><ComboBox x:Name="AaBox"/>
      <TextBlock x:Name="FilterLabel"/><ComboBox x:Name="FilterBox"/>
      <TextBlock x:Name="FpsLabel"/><ComboBox x:Name="FpsBox"/>
     </StackPanel>
    </UniformGrid>
    <TextBlock x:Name="FpsWarning" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
    <CheckBox x:Name="NativePortBox"/>
    <CheckBox x:Name="DiagnosticLogsBox"/>
    <CheckBox x:Name="FrameGenerationBox"/>
    <StackPanel x:Name="FrameGenerationPanel" Margin="0,0,0,12">
     <TextBlock x:Name="FrameGenDllLabel" Foreground="{StaticResource Muted}"/>
     <DockPanel Margin="0,6,0,0"><Button x:Name="BrowseDllButton" DockPanel.Dock="Right" Margin="8,0,0,0" Background="#30394A" Click="BrowseFrameGeneration_Click"/><TextBox x:Name="FrameGenerationDllBox"/></DockPanel>
    </StackPanel>
    <Expander x:Name="MoreGraphicsExpander" Foreground="{StaticResource Text}" Margin="0,0,0,16">
     <StackPanel Margin="0,10,0,0"><UniformGrid Columns="2">
      <StackPanel Margin="0,0,12,0"><TextBlock x:Name="ShadowLabel"/><ComboBox x:Name="ShadowBox"/></StackPanel>
      <StackPanel Margin="12,0,0,0"><TextBlock x:Name="MsaaLabel"/><ComboBox x:Name="MsaaBox"/></StackPanel>
     </UniformGrid><CheckBox x:Name="VSyncBox"/>
      <CheckBox x:Name="SkipIntroBox"/>
     </StackPanel>
    </Expander>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
     <StackPanel><TextBlock x:Name="GameFilesText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="GameExeLabel" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,12"><Button x:Name="BrowseExeButton" DockPanel.Dock="Right" Margin="8,0,0,0" Background="#30394A" Click="Browse_Click"/><TextBox x:Name="GameExeBox"/></DockPanel>
      <TextBlock x:Name="GameDataLabel" Foreground="{StaticResource Muted}"/>
      <DockPanel Margin="0,6,0,0"><Button x:Name="BrowseDataButton" DockPanel.Dock="Right" Margin="8,0,0,0" Background="#30394A" Click="BrowseData_Click"/><TextBox x:Name="GameDataBox"/></DockPanel>
     </StackPanel>
    </Border>
    <Expander x:Name="LaunchDetailsExpander" Foreground="{StaticResource Muted}" Margin="0,16,0,0"><TextBox x:Name="ArgumentsPreview" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Margin="0,10,0,0"/></Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
