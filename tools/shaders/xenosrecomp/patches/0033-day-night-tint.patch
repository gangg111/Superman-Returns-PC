@@ -1474,6 +1474,35 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         srWaterVertexShader |= strcmp(reinterpret_cast<const char*>(constantTableData + constantInfo->name),
                                       "gerstner_wave_amp") == 0;
     }
+    // Day and night: pixel shaders whose colour comes from textures rather than
+    // the game's lights get a tint the host writes to c200 (the sky dome:
+    // TopFogColor / gContinentLight; the sky backdrop: gHorizFogCol_KFog without
+    // gLightPos; water: gWaterSpec; the sun's flare: flareSampler). Same rule as
+    // tools/shaders/gen_light_regs.py.
+    srDayNightTintShader = false;
+    if (isPixelShader)
+    {
+        bool sky = false, fog = false, light = false, water = false, flare = false;
+        bool particleColor = false, particleDepth = false, particleTile = false;
+        for (uint32_t i = 0; i < constantTableContainer->constantTable.constants; i++)
+        {
+            const auto constantInfo = reinterpret_cast<const ConstantInfo*>(
+                constantTableData + constantTableContainer->constantTable.constantInfo + i * sizeof(ConstantInfo));
+            const char* name = reinterpret_cast<const char*>(constantTableData + constantInfo->name);
+            sky |= strcmp(name, "TopFogColor") == 0 || strcmp(name, "gContinentLight") == 0;
+            fog |= strcmp(name, "gHorizFogCol_KFog") == 0;
+            light |= strcmp(name, "gLightPos") == 0;
+            water |= strcmp(name, "gWaterSpec") == 0;
+            flare |= strcmp(name, "flareSampler") == 0;
+            particleColor |= strcmp(name, "colorMap") == 0;
+            particleDepth |= strcmp(name, "depthMap") == 0;
+            particleTile |= strcmp(name, "tileScaleOffset") == 0;
+        }
+        // Soft particles (colorMap, depthMap, tileScaleOffset): the sky's cloud
+        // sprites, smoke, fire; the host tints only alpha-blended draws.
+        const bool particle = particleColor && particleDepth && particleTile;
+        srDayNightTintShader = sky || (fog && !light && !water) || water || flare || particle;
+    }
