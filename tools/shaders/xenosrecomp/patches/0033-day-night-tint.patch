                     }
+                    // Day and night: the host's tint for colour the game's
+                    // lights do not reach (c200, valid with w = 12345).
+                    if (srDayNightTintShader && (reinterpret_cast<const PixelShader*>(shader)->outputs & PIXEL_SHADER_OUTPUT_COLOR0))
+                    {
