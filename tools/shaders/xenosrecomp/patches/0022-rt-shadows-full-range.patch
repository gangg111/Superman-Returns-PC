@@ -315,6 +315,18 @@ float4 srRtShadowDepth(float4 fetched)
 {
     return g_srRtShadowVis < 0.0 ? fetched : g_srRtShadowVis.xxxx;
 }
+// With ray-traced shadows the receivers keep shadows out to the ray-traced
+// scene's 4000 units instead of the cascades' 750: the literal cutoff
+// (750 * this) and the fade-out (FalloffStart .z, FalloffRate .w) scale by 4000 / 750.
+static const float kSrRtRangeScale = 4000.0 / 750.0;
+float srRtShadowRangeScale(float gameRange)
+{
+    return srRtShadowsReplace() ? max(gameRange, kSrRtRangeScale) : gameRange;
+}
+float4 srRtFade(float4 v)
+{
+    return srRtShadowsReplace() ? float4(v.x, v.y, v.z * kSrRtRangeScale, v.w / kSrRtRangeScale) : v;
+}
 #ifdef SR_VULKAN_BUFFERS
 [[vk::binding(0,2)]] SamplerState g_SamplerDescriptorHeap[32];
 #else
