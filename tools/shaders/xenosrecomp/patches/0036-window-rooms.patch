+// The camera of that view-projection: the clip point (0, 0, 1, 0) (the eye has
+// clip w = 0, whatever the depth convention). Zero when the lamps' data is off.
+float3 srLampCamera()
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    if (b.Load(160) == 0)
+        return 0.0;
+    float4 c = float4(asfloat(b.Load(192 + 8)), asfloat(b.Load(208 + 8)), asfloat(b.Load(224 + 8)), asfloat(b.Load(240 + 8)));
+    return abs(c.w) > 1e-12 ? c.xyz / c.w : 0.0;
+}
