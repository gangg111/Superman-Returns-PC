+// How much a building pixel glows at night (0..1) and the warmth key of its
+// room (tone). glass: the glass layer's weight here, glassCoarse: its mean
+// around; p: the world position (hasPos), else uv places the rooms.
+// Windows drawn in the texture: the glass mask is the window, rooms are 3.2 x
+// 3.6 world cells, four in ten lit. Curtain walls: a window grid laid on the
+// facade itself (axes from the surface normal, 2-unit bays, 3.6-unit floors,
+// frames between the panes, rooms three bays wide, whole floors mostly dark),
+// fading to its mean where the panes are smaller than a pixel.
+float srWindowLight(float3 p, bool hasPos, float glass, float glassCoarse, float2 uv, out float tone)
+{
+    // Rooms by the material map's tile (whole UV repeats): a facade texture repeats per bay or
+    // floor, so a tile's panes light together and no pane is cut in two.
+    float3 cell = float3(floor(uv), 7.0);
+    float h = srWindowHash(cell);
+    tone = frac(h * 17.31);
+    float amount = smoothstep(0.25, 0.55, glass) * (h < 0.42 ? 0.6 + 0.4 * tone : 0.0);
+    // A room lit from its ceiling: a little brighter at the top of the window.
+    if (hasPos) amount *= 0.7 + 0.3 * frac(p.y / 3.6);
+    // Curtain walls only where glass covers nearly everything; facades with framed panes
+    // (mean around 0.6-0.85) keep the windows of their texture.
+    float curtain = hasPos ? smoothstep(0.9, 0.97, glassCoarse) : 0.0;
+    [branch] if (curtain > 0.0)
+    {
+        // The pixel normal from position derivatives is noisy: only its dominant
+        // horizontal axis is used (city facades are mostly axis-aligned), so the
+        // grid and the facade's identity hold steady across the wall.
+        float3 n = normalize(cross(ddx(p), ddy(p)) + 1e-6);
+        float wall = 1.0 - smoothstep(0.5, 0.8, abs(n.y));
+        bool alongZ = abs(n.x) > abs(n.z);  // the wall faces x: it runs along z
+        float2 g = float2((alongZ ? p.z : p.x) / 2.0, p.y / 3.6);
+        float2 f = frac(g);
+        float2 w = max(fwidth(g), 1e-4);
+        float open = saturate(min(f.x - 0.12, 0.88 - f.x) / w.x + 0.5) * saturate(min(f.y - 0.22, 0.86 - f.y) / w.y + 0.5);
+        open = lerp(open, 0.76 * 0.64, saturate(max(w.x, w.y) * 2.0 - 0.5));
+        // The facade: its direction and its plane, so neighbours differ.
+        float facade = (alongZ ? 1.0 : 2.0) * 131.0 + floor((alongZ ? p.x : p.z) / 6.0 + 0.5);
+        float hr = srWindowHash(float3(floor(g.x / 3.0), floor(g.y), facade));
+        float hf = srWindowHash(float3(floor(g.y), facade, 3.7));
+        float lit = hr < (hf < 0.35 ? 0.08 : 0.32) ? 1.0 : 0.0;
+        float roomTone = frac(hr * 17.31);
+        float curtainAmount = wall * open * lit * (0.5 + 0.5 * frac(hr * 31.7)) * saturate(glassCoarse * 1.5);
+        g_srWinDebug = float3(amount, curtainAmount, curtain);
+        amount = lerp(amount, curtainAmount, curtain);
+        tone = lerp(tone, roomTone, curtain);
+    }
+    else
+        g_srWinDebug = float3(amount, 0.0, 0.0);
+    return amount;
+}
