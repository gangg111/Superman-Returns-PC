+// Night windows (patch 0034). The material map's mean 4 mips up: a facade whose
+// glass layer covers nearly everything is a curtain wall, one with windows
+// drawn in the texture has a much lower mean.
+// The window light itself follows the map 2 mips up (about 4 x 4 texels): the
+// glass layer's fine pattern (dirt, bright frames) would light the panes in
+// blotches and outlines; blurred, a pane lights evenly and its frame stays dark.
+// The whole texture's mean (its last mip): a curtain wall is glass all over,
+// a facade with framed panes is not, however big a single pane is (a local
+// mean inside a big pane is 1 too, which put the curtain grid inside panes).
+float4 srMatMean(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord)
+{
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[TEX_INDEX(resourceDescriptorIndex)];
+    return conanGamma(resourceDescriptorIndex, texture.SampleLevel(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord, 16.0));
+}
+float4 srMatCoarse(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float bias)
+{
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[TEX_INDEX(resourceDescriptorIndex)];
+    return conanGamma(resourceDescriptorIndex, texture.SampleBias(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord, bias));
+}
