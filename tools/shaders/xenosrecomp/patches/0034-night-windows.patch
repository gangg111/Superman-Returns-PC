+// Night street lamps (frame data bytes 160..: count, reach, light colour,
+// the night's ambient light; 256..: one lamp head per 16 bytes): light added
+// to a lit pixel's colour, scaled by the colour it would have under white light.
+// A pixel's world position from its depth: the inverse view-projection the
+// lamps' shader drew with (bytes 192..255, rows) and its viewport (1280..1295).
+float3 srLampWorldPos(float4 pos)
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    if (b.Load(160) == 0)
+        return 0.0;
+    float4 vp = asfloat(b.Load4(1280));
+    float4 clip = float4((pos.x - vp.x) / vp.z * 2.0 - 1.0, 1.0 - (pos.y - vp.y) / vp.w * 2.0, pos.z, 1.0);
+    float4 p = float4(dot(asfloat(b.Load4(192)), clip), dot(asfloat(b.Load4(208)), clip),
+                      dot(asfloat(b.Load4(224)), clip), dot(asfloat(b.Load4(240)), clip));
+    return p.xyz / p.w;
+}
+float3 srLampLight(float3 worldPos, float3 color)
+{
+    ByteAddressBuffer b = g_RtBuffers[SR_RT_FRAME_INDEX];
+    uint n = min(b.Load(160), 64u);
+    if (n == 0)
+        return 0.0;
+    float reach = asfloat(b.Load(164));
+    float3 light = asfloat(b.Load3(168));
+    float3 ambient = asfloat(b.Load3(180));
+    float sum = 0.0, glow = 0.0;
+    for (uint i = 0; i < n; i++)
+    {
+        float3 d = asfloat(b.Load3(256 + i * 16)) - worldPos;
+        float dd = dot(d, d);
+        float f = saturate(1.0 - dd / (reach * reach));
+        // Mostly downwards (a shaded head): full under it, a tenth sideways.
+        sum += f * f * (0.1 + 0.9 * saturate(d.y * rsqrt(max(dd, 1e-4))));
+        // The lamp itself: its head glows (within 2 units of the light).
+        glow += saturate(1.0 - dd * 0.25);
+    }
+    float lum = max(dot(ambient, float3(0.2126, 0.7152, 0.0722)), 0.05);
+    return color / lum * light * sum + light * glow * 4.0;
+}
