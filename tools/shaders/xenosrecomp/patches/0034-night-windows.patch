+float srWindowHash(float3 c) { return frac(sin(dot(c, float3(12.9898, 78.233, 37.719))) * 43758.5453); }
+
+// The far city's low-detail buildings (gLowLOD_col, no textures) at night: the
+// curtain-wall window grid of srWindowLight laid on them. Host constants: the
+// draw's viewport, its inverse view-projection rows, the windows' brightness.
+float srWindowLight(float3 p, bool hasPos, float glass, float glassCoarse, float2 uv, out float tone);
+float3 srLodCityWindows(float4 pos, float4 vp, float4 r0, float4 r1, float4 r2, float4 r3, float brightness)
+{
+    float4 clip = float4((pos.x - vp.x) / vp.z * 2.0 - 1.0, 1.0 - (pos.y - vp.y) / vp.w * 2.0, pos.z, 1.0);
+    float4 p = float4(dot(r0, clip), dot(r1, clip), dot(r2, clip), dot(r3, clip));
+    float tone;
+    float a = srWindowLight(p.xyz / p.w, true, 1.0, 1.0, 0.0, tone);
+    return lerp(float3(1.0, 0.72, 0.42), float3(0.85, 0.92, 1.0), tone * tone) * a * brightness;
+}
+
+// The sun and the moon on the sky backdrop (patch 0034), from host constants:
+// sun / moon (direction, brightness), the draw's viewport, its inverse
+// view-projection rows, the camera, the sun's colour.
+#define SR_SKY_MOON_INDEX 32761  // the host's moon texture (kSkyMoonSrv), premultiplied RGBA
+float3 srSkyBodies(float4 pos, float4 sun, float4 moon, float4 vp, float4 r0, float4 r1, float4 r2, float4 r3,
+                   float3 cam, float4 sunColour, uint samplerIndex)
+{
+    float4 clip = float4((pos.x - vp.x) / vp.z * 2.0 - 1.0, 1.0 - (pos.y - vp.y) / vp.w * 2.0, 0.5, 1.0);
+    float4 p = float4(dot(r0, clip), dot(r1, clip), dot(r2, clip), dot(r3, clip));
+    float3 dir = normalize(p.xyz / p.w - cam);
+    float pixelAngle = max(length(fwidth(dir)), 1e-6);  // outside the branches: derivatives need all lanes
+    float3 c = 0.0;
+    // Sun: a disc of about 1.4 degrees with a soft edge, a tight corona and a wide haze.
+    float ds = dot(dir, sun.xyz);
+    float disc = smoothstep(0.99970, 0.99982, ds);
+    float corona = pow(saturate(ds), 600.0) * 0.8 + pow(saturate(ds), 60.0) * 0.18 + pow(saturate(ds), 8.0) * 0.05;
+    c += sunColour.rgb * sun.w * (disc * 5.0 + corona);
+    // Stars at night: a sparse field on a direction grid (about 1 cell in 30 lit),
+    // mostly faint, a few brighter, slowly twinkling; the cloud dome drawn over
+    // the backdrop hides them where it is thick, and they fade near the horizon.
+    [branch] if (moon.w > 0.0 && dir.y > 0.0)
+    {
+        float3 sd = dir * 260.0;
+        float3 cell = floor(sd);
+        float h = srWindowHash(cell + 17.0);
+        if (h < 0.035)
+        {
+            float3 at = cell + 0.5 + (float3(srWindowHash(cell + 3.1), srWindowHash(cell + 5.7), srWindowHash(cell + 9.3)) - 0.5) * 0.6;
+            float d = length(sd - at);
+            float size = max(pixelAngle * 260.0 * 1.2, 0.08);  // about a pixel and a bit
+            float star = saturate(1.0 - d / size);
+            float mag = pow(srWindowHash(cell + 41.0), 6.0) * 7.0 + 0.9;
+            float3 tint = lerp(float3(0.8, 0.88, 1.0), float3(1.0, 0.9, 0.78), srWindowHash(cell + 23.0));
+            c += tint * star * star * mag * moon.w * smoothstep(0.02, 0.25, dir.y);
+        }
+    }
+    // Moon: a pale disc, darker towards its rim, with faint seas; a little glow.
+    float dm = dot(dir, moon.xyz);
+    [branch] if (moon.w > 0.0 && dm > 0.997)
+    {
+        float3 up = abs(moon.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
+        float3 ax = normalize(cross(up, moon.xyz)), ay = cross(moon.xyz, ax);
+        float2 q = float2(dot(dir, ax), dot(dir, ay)) / 0.0480;  // disc radius about 2.75 degrees
+        float rr = dot(q, q);
+        [branch] if (sunColour.w > 0.0)
+        {
+            // The painted moon (textures/sky_moon.dds): premultiplied, its own rim.
+            // The mip whose texels match the disc's pixels (512 texels over its diameter).
+            float lod = max(log2(512.0 * pixelAngle / (2.0 * 0.0480)), 0.0);
+            float4 t = rr < 1.0 ? g_Texture2DDescriptorHeap[SR_SKY_MOON_INDEX].SampleLevel(
+                                      g_SamplerDescriptorHeap[samplerIndex], float2(0.5 + 0.5 * q.x, 0.5 - 0.5 * q.y), lod)
+                                : 0.0;
+            c += t.rgb * float3(0.95, 0.97, 1.03) * moon.w * 2.8;
+            c += float3(0.55, 0.62, 0.8) * moon.w * (pow(saturate(dm), 2000.0) * 0.15 + pow(saturate(dm), 150.0) * 0.06);
+            return c;
+        }
+        float inside = 1.0 - smoothstep(0.90, 1.0, rr);
+        float limb = sqrt(saturate(1.0 - rr));
+        // Seas: smooth dark blotches (a few crossed waves), brighter highlands between.
+        float n = sin(q.x * 3.1 + 1.7) * sin(q.y * 2.6 + 0.4) + 0.6 * sin(q.x * 5.3 - q.y * 4.1 + 2.2) +
+                  0.35 * sin(q.x * 9.7 + q.y * 7.9 + 0.9);
+        float seas = 1.0 - 0.32 * smoothstep(0.2, 0.9, n);
+        c += float3(0.86, 0.88, 0.94) * moon.w * inside * (0.6 + 0.4 * limb) * seas * 0.9;
+    }
+    c += float3(0.55, 0.62, 0.8) * moon.w * (pow(saturate(dm), 2000.0) * 0.15 + pow(saturate(dm), 150.0) * 0.06);
+    return c;
+}
