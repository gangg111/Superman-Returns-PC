+#if (__SHADER_TARGET_MAJOR > 6 || (__SHADER_TARGET_MAJOR == 6 && __SHADER_TARGET_MINOR >= 5))
+// Alpha-tested instances (tree leaves, fences: material flag bit 12, threshold
+// at byte 124 of the 128-byte entry) are non-opaque: a candidate hit counts
+// only where the colour texture's alpha at its UV passes the game's test
+// (alpha > threshold), so light goes through the gaps between the leaves.
+bool srRtAlphaPass(uint id, uint prim, float2 bary)
+{
+    ByteAddressBuffer materials = g_RtBuffers[SR_RT_MATERIAL_INDEX];
+    uint4 m = materials.Load4(id * 128);
+    uint flags = materials.Load(id * 128 + 20);
+    if ((flags & (1u << 12)) == 0 || m.x == 0xFFFFFFFFu || m.y == 0xFFFFFFu)
+        return true;
+    ByteAddressBuffer pool = g_RtBuffers[SR_RT_UV_INDEX];
+    uint b = (m.x + prim * 3) * 32;
+    float w0 = 1.0 - bary.x - bary.y;
+    float4 a = asfloat(pool.Load4(b)) * w0 + asfloat(pool.Load4(b + 32)) * bary.x + asfloat(pool.Load4(b + 64)) * bary.y;
+    float4 xf = asfloat(materials.Load4(id * 128 + 32));
+    float2 uv = float2(a[m.z & 3u], a[(m.z >> 2) & 3u]) * xf.xy + xf.zw;
+    Texture2D<float4> tex = g_Texture2DDescriptorHeap[NonUniformResourceIndex(m.y & 0x7FFFu)];
+    SamplerState samp = g_SamplerDescriptorHeap[NonUniformResourceIndex((m.z >> 8) & 0xFFFFu)];
+    return tex.SampleLevel(samp, uv, 0.0).a > asfloat(materials.Load(id * 128 + 124));
+}
 #endif
 
