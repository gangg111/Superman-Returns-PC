+    float4(-0.323290,  0.946300, 1.305002, 0.018298),
+    float4( 0.900447,  0.434966, 1.812503, 0.011179),
+    float4( 0.267499,  0.963558, 2.517365, 0.006830),
+    float4( 1.000000,  0.000000, 3.496340, 0.004173),
+    float4(-0.029200,  0.999574, 4.856028, 0.002549)};
+static const float2 g_srWaterWaveB[SR_WATER_WAVES] = {  // omega = sqrt(9.81 k), phase
+    float2(1.133193, 0.0), float2(1.335481, 1.7), float2(1.573879, 3.4), float2(1.854834, 5.1),
+    float2(2.185943, 6.8), float2(2.576158, 8.5), float2(3.036032, 10.2), float2(3.577998, 11.9),
