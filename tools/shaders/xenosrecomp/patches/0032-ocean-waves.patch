+// The water vertex shader's position input (object space): moved by the waves
+// in world space (Mobj rows m0..m2, the disc's centre = the camera), then back.
+// (Macros pass g_SrWaterWaves: the shared constants are declared after this file.)
+#define srWaterDisplace(P, M0, M1, M2, T) srWaterDisplaceImpl(P, M0, M1, M2, T, g_SrWaterWaves)
+float4 srWaterDisplaceImpl(float4 p, float4 m0, float4 m1, float4 m2, float t, float scale)
+{
+    if (scale <= 0.0)
+        return p;
+    float4 q = float4(p.xyz, 1.0);
+    float3 w = float3(dot(m0, q), dot(m1, q), dot(m2, q));
+    float3 d = srWaterGerstner(w.xz, t, scale, length(w.xz - float2(m0.w, m2.w)));
+    // Object-space offset: the inverse of Mobj's 3x3 part (adjugate / determinant).
+    float3 r0 = m0.xyz, r1 = m1.xyz, r2 = m2.xyz;
+    float3 c0 = cross(r1, r2), c1 = cross(r2, r0), c2 = cross(r0, r1);
