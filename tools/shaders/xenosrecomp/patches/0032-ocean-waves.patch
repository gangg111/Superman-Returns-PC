+float srWaterFade(float k, float fadeDist, float fadeLen)
+{
+    float wavelength = 6.2831853 / k;
+    return saturate(2.0 - fadeDist / (wavelength * fadeLen));
+}
+// Displacement of the surface point that rests at xz.
+float3 srWaterGerstner(float2 xz, float t, float scale, float fadeDist)
+{
+    float q = g_srWaterSteepness / max(1.0, scale * 0.440);
+    float3 d = 0.0;
+    [unroll] for (int i = 0; i < SR_WATER_WAVES; i++)
+    {
+        float4 w = g_srWaterWaveA[i];
+        float a = w.w * scale * srWaterFade(w.z, fadeDist, 6.0);
+        float ph = w.z * dot(w.xy, xz) - g_srWaterWaveB[i].x * t + g_srWaterWaveB[i].y;
+        float s, c;
+        sincos(ph, s, c);
+        d.xz += q * a * w.xy * c;
+        d.y += a * s;
+    }
+    return d;
+}
+// Surface normal at the point resting at xz.
+float3 srWaterNormal(float2 xz, float t, float scale, float fadeDist)
+{
+    float q = g_srWaterSteepness / max(1.0, scale * 0.440);
+    float3 n = float3(0.0, 1.0, 0.0);
+    [unroll] for (int i = 0; i < SR_WATER_WAVES; i++)
+    {
+        float4 w = g_srWaterWaveA[i];
+        float a = w.w * scale * srWaterFade(w.z, fadeDist, 12.0);
+        float ph = w.z * dot(w.xy, xz) - g_srWaterWaveB[i].x * t + g_srWaterWaveB[i].y;
+        float s, c;
+        sincos(ph, s, c);
+        n.xz -= w.xy * (w.z * a * c);
+        n.y -= q * w.z * a * s;
+    }
+    return normalize(n);
