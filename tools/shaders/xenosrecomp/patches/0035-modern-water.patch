                                "if (srRtDebug() == 14) oC0 = float4(g_srWinDebug, 1.0); "
                                "else if (srRtDebug() == 15) oC0 = float4(dot(g_srMatMid.xyz, srK) / srKmax, dot(g_srMat.xyz, srK) / srKmax, 0.0, 1.0); } }\n";
                     }
+                    // The open water (patch 0035): Crest's ripples on the game's
+                    // normal, right after the game normalises it (r7.yzw, r7.w up;
+                    // host constant c201, valid with w = 12345).
